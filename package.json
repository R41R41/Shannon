{
  "name": "shannon",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "common"
  ],
  "scripts": {
    "postinstall": "npm run build -w common && patch-package",
    "build": "npm run build -w common && npm run build -w backend",
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "clean": "rm -rf */dist",
    "dev-backend": "npm run dev -w backend",
    "dev-frontend": "npm run dev -w frontend"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.3.25",
    "@notionhq/client": "^2.3.0",
    "@shannon/common": "*",
    "canvas": "^3.1.0",
    "jimp": "^1.6.0",
    "minecraft-data": "^3.105.0",
    "minecrafthawkeye": "^1.3.9",
    "newsapi": "^2.4.1",
    "node-canvas-webgl": "^0.3.0",
    "openai": "^6.22.0",
    "opusscript": "^0.1.1",
    "prismarine-block": "^1.21.0",
    "prismarine-viewer": "^1.33.0",
    "wikipedia": "^2.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "concurrently": "^8.2.2",
    "patch-package": "^8.0.1",
    "ts-node": "^10.9.2",
    "tsc-watch": "^6.2.1",
    "tsconfig-paths": "^4.2.0"
  }
}
