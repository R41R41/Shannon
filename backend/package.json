{
  "name": "@shannon/backend",
  "type": "module",
  "scripts": {
    "prebuild": "npm run build --workspace=@shannon/common --prefix ..",
    "predev": "npm run build --workspace=@shannon/common --prefix ..",
    "build": "tsc",
    "build:fast": "swc src -d dist --source-maps --copy-files --strip-leading-paths",
    "build:check": "tsc --noEmit",
    "start": "node --experimental-specifier-resolution=node --es-module-specifier-resolution=node dist/server.js",
    "dev": "tsc-watch --onSuccess \"node --experimental-specifier-resolution=node --es-module-specifier-resolution=node dist/server.js\"",
    "dev:dev": "tsc-watch --onSuccess \"node --experimental-specifier-resolution=node --es-module-specifier-resolution=node dist/server.js --dev\"",
    "test": "vitest",
    "test:graph": "tsc-watch --onSuccess \"node --experimental-specifier-resolution=node --es-module-specifier-resolution=node dist/services/llm/graph/test.js\"",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "migrate:up": "migrate-mongo up",
    "migrate:down": "migrate-mongo down",
    "migrate:status": "migrate-mongo status",
    "migrate:create": "migrate-mongo create",
    "minebot:list": "ts-node --esm scripts/minebot-test.ts --list",
    "minebot:smoke": "ts-node --esm scripts/minebot-test.ts --smoke",
    "minebot:test": "ts-node --esm scripts/minebot-test.ts --skill",
    "check:foundation": "node ../scripts/check-foundation-boundaries.cjs && tsc -p tsconfig.foundation.json",
    "check:access-integration": "NODE_OPTIONS='--max-old-space-size=12288' tsc -p tsconfig.access-integration.json",
    "check:backend-strict": "npm run check:foundation && npm run check:access-integration && npm run check:memory-integration",
    "test:offline": "vitest run tests/unit tests/selfImprove/nightlySchedule.test.ts --maxWorkers=1 --minWorkers=1",
    "check:memory-integration": "tsc -p tsconfig.memory-integration.json"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.0",
    "@langchain/anthropic": "^0.3.34",
    "@langchain/community": "^0.3.44",
    "@langchain/core": "^0.3.58",
    "@langchain/langgraph": "^0.2.71",
    "@langchain/openai": "^0.5.10",
    "@shannon/common": "*",
    "@snazzah/davey": "^0.1.9",
    "@types/twit": "^2.2.35",
    "@wolfram-alpha/wolfram-alpha-api": "^23.1004.144821-RELEASE",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "discord.js": "^14.0.0",
    "dotenv": "^16.0.0",
    "express": "^4.21.2",
    "firebase-admin": "13.10.0",
    "googleapis": "^126.0.1",
    "jimp": "^1.6.0",
    "langchain": "^0.3.13",
    "langfuse": "^3.38.6",
    "langfuse-langchain": "^3.38.6",
    "minecraft-protocol-forge": "^1.0.0",
    "minecrafthawkeye": "^1.3.6",
    "mineflayer": "^4.35.0",
    "mineflayer-cmd": "^1.1.3",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-projectile": "^0.1.1",
    "mineflayer-pvp": "^1.3.2",
    "mineflayer-tool": "^1.2.0",
    "mongoose": "^7.0.0",
    "node-cron": "^3.0.3",
    "oauth-1.0a": "^2.2.6",
    "openai": "^4.80.0",
    "prismarine-chunk": "^1.38.1",
    "prismarine-registry": "^1.11.0",
    "sodium-native": "^5.0.10",
    "twit": "^2.2.11",
    "twitter-api-v2": "^1.19.0",
    "vec3": "^0.1.10",
    "winston": "^3.10.0",
    "wolfram-alpha-api": "^0.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/cron": "^2.4.3",
    "@types/express": "^4.17.0",
    "@types/node-cron": "^3.0.11",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "canvas": "^3.1.0",
    "cron": "^3.5.0",
    "dotenv": "^16.4.7",
    "prismarine-viewer": "^1.33.0",
    "ts-node": "^10.9.1",
    "tsc-watch": "^6.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
