# Dedicated dev env, never source the shared backend/.env. Empty allowlists deny.
LINE_ENABLED=false
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_BOT_USER_ID=
# Comma-separated C... IDs. Names and * are not accepted.
LINE_ALLOWED_GROUP_IDS=
# addressed: mention the bot or start with "シャノン、" / "Shannon," / "/shannon ".
LINE_GROUP_REPLY_MODE=addressed
# U... ID for the sole personal recipient. Never use a group ID here.
LINE_PERSONAL_USER_ID=
# No paid LLM calls / proactive sends until explicit budgets are configured.
LINE_CHAT_MAX_PER_24H=0
LINE_PUSH_MAX_PER_MONTH=0
LINE_PUSH_MAX_PER_24H=0
LINE_QUIET_START_JST=22
LINE_QUIET_END_JST=8
LINE_LLM_MODEL=
LINE_LLM_API_KEY=
# Optional public web search for LINE chat FCA. Empty omits the tool.
LINE_WEB_SEARCH_API_KEY=
LINE_WEB_SEARCH_ENGINE_ID=
# Dedicated least-privilege OAuth grant: exactly youtube.readonly + calendar.events.readonly.
LINE_GOOGLE_CLIENT_ID=
LINE_GOOGLE_CLIENT_SECRET=
LINE_GOOGLE_REFRESH_TOKEN=
# Optional IdentityProfile gate for personal chat/Radar push. Requires bindings.line + lineDeliveryEnabled.
LINE_FIREBASE_PROJECT_ID=
LINE_IDENTITY_MONGODB_URI=mongodb://127.0.0.1:27017/shannon_dev
# Epoch milliseconds, explicit dev run permit expiry (at most 24 hours).
LINE_PERMIT_UNTIL=
