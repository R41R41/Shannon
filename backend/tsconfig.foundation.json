{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "lib": [
      "ES2022",
      "ESNext.Disposable"
    ],
    "skipLibCheck": false
  },
  "include": [
    "src/modules/access/**/*.ts",
    "src/modules/modelSettings/**/*.ts",
    "src/modules/execution/**/*.ts",
    "src/modules/memory/**/*.ts",
    "src/modules/conversation/**/*.ts",
    "src/modules/radar/**/*.ts",
    "src/modules/fca/**/*.ts",
    "src/modules/identity/**/*.ts"
  ]
}
