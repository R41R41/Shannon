 "hand": {
  "undefined": "as_now",
  "empty": "relies_on_nothing",
  "listed": "all_listed_reliable",
  "onFailContinueExempts": false,
  "indirect": "a_not_run_hand_is_not_reliable",
  "repeat": "same_pass_only",
  "refusedShapes": [
   "self",
   "later_hand",
   "out_of_range",
   "duplicate"
  ],
  "released": "a hand is reliable when its goal is done|already and end finished (the act is released as a whole)"
 },
 "item": {
  "undefined": "drop_as_now",
  "empty": "relies_on_nothing",
  "keep": {
   "succeeded": "keep",
   "pending": "keep",
   "failed": "drop:depends_failed",
   "unknown": "drop:depends_unknown"
  },
  "start": {
   "allSucceeded_preTrue_bodyNotHeld": "start",
   "anyPending": "wait",
   "preFalse": "not_started:precondition",
   "preUnknown": "not_started:precondition_unknown"
  },
  "admitAfterStopped": "admit_if_not_in_dependsOn_but_never_skip_tail",
  "replace": "listed removed; removal propagates as failure; kept only dependsOn arrays without a removed item",
  "crossStep": "refused_before_send_with_usable_refs"
 },
 "dependState": {
  "succeeded": "goal done|already AND end finished AND released",
  "pending": "not ended (running or waiting)",
  "failed": "ended AND released AND not succeeded",
  "unknown": "end unknown OR released not confirmed OR reference not remembered",
  "note": "重なりは dependStatePriority の順で解く（上から最初に当たった物）"
 },
 "aggregate": [
  "doneMet → done",
  "all done|already with ≥1 done → done; all already → already",
  "any unknown → unknown",
  "any done|partial → partial",
  "any motorOps > 0 → failed",
  "else → not_started"
 ],
 "dependStatePriority": [
  "reference not remembered → unknown",
  "not ended → pending",
  "released not confirmed → unknown",
  "end unknown → unknown",
  "goal done|already AND end finished → succeeded",
  "else → failed"
 ]
}
