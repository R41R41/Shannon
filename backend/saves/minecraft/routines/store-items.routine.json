{
  "name": "store-items",
  "description": "チェストにアイテムを収納する",
  "params": [
    { "name": "chestX", "type": "number", "description": "チェスト X", "required": true },
    { "name": "chestY", "type": "number", "description": "チェスト Y", "required": true },
    { "name": "chestZ", "type": "number", "description": "チェスト Z", "required": true },
    { "name": "itemName", "type": "string", "description": "収納アイテム", "required": true },
    { "name": "count", "type": "number", "description": "個数 (0=全部)", "required": false, "default": 0 }
  ],
  "instruction": "move-to(${chestX}, ${chestY}, ${chestZ}, range:3) でチェストに近づき、deposit-to-container(${chestX}, ${chestY}, ${chestZ}, ${itemName}, ${count}) で収納する。",
  "tools": ["move-to", "deposit-to-container", "check-inventory-item", "get-position"],
  "maxIterations": 5,
  "model": "haiku",
  "failureEscalation": "system2",
  "source": "manual",
  "stats": { "runs": 0, "successes": 0, "failures": 0, "avgDurationMs": 0 }
}
