{
  "name": "gather-wood",
  "description": "原木を採掘して拾う",
  "params": [
    {
      "name": "count",
      "type": "number",
      "description": "採掘個数",
      "required": false,
      "default": 4
    },
    {
      "name": "woodType",
      "type": "string",
      "description": "原木の種類",
      "required": false,
      "default": "oak_log"
    }
  ],
  "instruction": "mine-block(${woodType}, count:${count}) で原木を一括採掘する。完了後 pickup-nearest-item でドロップを回収。mine-block が内部で移動・採掘を処理するので、find-blocks や move-to を別途呼ぶ必要はない。",
  "tools": [
    "mine-block",
    "pickup-nearest-item",
    "find-blocks",
    "move-to",
    "get-position"
  ],
  "maxIterations": 10,
  "model": "sonnet",
  "failureEscalation": "system2",
  "source": "manual",
  "stats": {
    "runs": 4,
    "successes": 3,
    "failures": 1,
    "avgDurationMs": 35670
  }
}