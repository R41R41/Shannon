{
  "name": "hunt-animal",
  "description": "指定した動物を探して倒し、ドロップを拾う。【注意: このルーチンは find + attack-continuously のみ。動物が遠い場合は先に move-to で近づいてからこのルーチンを使え】",
  "params": [
    {
      "name": "animalType",
      "type": "string",
      "description": "狩る動物の種類 (cow, pig, sheep 推奨)",
      "required": false,
      "default": "cow"
    },
    {
      "name": "searchRadius",
      "type": "number",
      "description": "探索半径",
      "required": false,
      "default": 32
    }
  ],
  "steps": [
    {
      "skill": "find-nearest-entity",
      "args": {
        "entityType": "${animalType}",
        "maxDistance": "${searchRadius}"
      },
      "outputVar": "findResult",
      "onFailure": "abort"
    },
    {
      "skill": "attack-continuously",
      "args": {
        "entityName": "${animalType}",
        "maxAttacks": 20
      },
      "onFailure": "continue"
    },
    {
      "skill": "wait-time",
      "args": { "milliseconds": 1500 },
      "onFailure": "skip"
    },
    {
      "skill": "pickup-nearest-item",
      "args": { "maxDistance": 16 },
      "onFailure": "skip"
    },
    {
      "skill": "pickup-nearest-item",
      "args": { "maxDistance": 16 },
      "onFailure": "skip"
    }
  ],
  "failureEscalation": "system2",
  "source": "manual",
  "stats": { "runs": 0, "successes": 0, "failures": 0, "avgDurationMs": 0 }
}
