{
  "testSuite": "furnace-skills",
  "description": "かまど操作スキル（かまどを /setblock で設置）",
  "globalSetup": [
    "/tp @s 0 64 0",
    "/setblock 2 64 0 furnace"
  ],
  "cases": [
    {
      "skillName": "check-furnace",
      "args": [2, 64, 0],
      "description": "空のかまどを確認",
      "prechecks": [
        { "type": "nearby_block", "block": "furnace", "maxDistance": 8 }
      ],
      "expectedOutcome": "success"
    },
    {
      "skillName": "start-smelting",
      "args": [2, 64, 0, "raw_iron", "coal", 1],
      "description": "鉄鉱石を石炭で精錬開始",
      "setup": [
        "/clear @s",
        "/give @s raw_iron 3",
        "/give @s coal 3"
      ],
      "prechecks": [
        { "type": "inventory_has", "item": "raw_iron", "minCount": 1 },
        { "type": "inventory_has", "item": "coal", "minCount": 1 },
        { "type": "nearby_block", "block": "furnace", "maxDistance": 8 }
      ],
      "expectedOutcome": "success"
    },
    {
      "skillName": "check-furnace",
      "args": [2, 64, 0],
      "description": "精錬中のかまどを確認（前テストで開始済み）",
      "prechecks": [
        { "type": "nearby_block", "block": "furnace", "maxDistance": 8 }
      ],
      "expectedOutcome": "success"
    },
    {
      "skillName": "withdraw-from-furnace",
      "args": [2, 64, 0, "all"],
      "description": "かまどから全スロット回収",
      "prechecks": [
        { "type": "nearby_block", "block": "furnace", "maxDistance": 8 }
      ],
      "expectedOutcome": "either"
    },
    {
      "skillName": "start-smelting",
      "args": [2, 64, 0, "raw_gold", "coal", 1],
      "description": "金鉱石を精錬",
      "setup": [
        "/clear @s",
        "/give @s raw_gold 2",
        "/give @s coal 2"
      ],
      "prechecks": [
        { "type": "inventory_has", "item": "raw_gold", "minCount": 1 },
        { "type": "inventory_has", "item": "coal", "minCount": 1 }
      ],
      "expectedOutcome": "success"
    },
    {
      "skillName": "check-furnace",
      "args": [100, 64, 100],
      "description": "存在しない座標のかまど → 失敗期待",
      "expectedOutcome": "failure"
    },
    {
      "skillName": "start-smelting",
      "args": [2, 64, 0, "raw_iron", "coal", 1],
      "description": "燃料なしで精錬 → 失敗期待",
      "setup": [
        "/clear @s",
        "/give @s raw_iron 1"
      ],
      "expectedOutcome": "failure"
    }
  ]
}
