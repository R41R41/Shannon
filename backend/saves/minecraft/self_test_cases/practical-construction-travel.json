{
  "testSuite": "practical-construction-travel",
  "description": "防壁建築、垂直脱出、階段採掘、ネザーゲート建築、睡眠、次元移動を行う遠征拠点シナリオ",
  "mode": "default",
  "commandOracle": true,
  "globalSetup": [
    "/gamemode survival @s",
    "/difficulty peaceful",
    "/gamerule doMobSpawning false",
    "/time set day",
    "/weather clear",
    "/effect clear @s",
    "/clear @s",
    "/tp @s 0 100 0",
    "/kill @e[type=!player]",
    "/kill @e[type=item]",
    "/fill -12 99 -12 12 99 12 stone",
    "/fill -12 100 -12 12 110 12 air",
    "/tp @s 0 100 0"
  ],
  "cases": [
    {
      "skillName": "fill-area",
      "args": [3, 100, -1, 3, 101, 1, "cobblestone"],
      "description": "夜襲に備えて丸石6個の小さな防壁を建てる",
      "expectedOutcome": "success",
      "setup": ["/give @s cobblestone 6"],
      "assertions": [
        { "type": "block_at", "x": 3, "y": 100, "z": -1, "block": "cobblestone" },
        { "type": "block_at", "x": 3, "y": 101, "z": 1, "block": "cobblestone" }
      ]
    },
    {
      "skillName": "tower-up",
      "args": [2, "cobblestone"],
      "description": "洞窟からの垂直脱出を想定して2ブロック積み上がる",
      "expectedOutcome": "success",
      "setup": ["/give @s cobblestone 4"],
      "assertions": [{ "type": "position_within", "x": 0, "y": 102, "z": 0, "radius": 2 }]
    },
    {
      "skillName": "stair-mine",
      "args": [100, "east", "cobblestone"],
      "description": "地下資源へ向かうため東向きに2段の階段を掘り下げる",
      "expectedOutcome": "success",
      "setup": [
        "/fill -4 98 -4 8 101 4 stone",
        "/fill -4 102 -4 8 108 4 air",
        "/give @s iron_pickaxe 1",
        "/give @s cobblestone 8",
        "/tp @s 0 102 0"
      ],
      "assertions": [{ "type": "position_within", "x": 2, "y": 100, "z": 0, "radius": 3 }]
    },
    {
      "skillName": "build-structure",
      "args": ["nether_portal", 4, 100, -2, "south"],
      "description": "黒曜石と火打石から遠征用ネザーゲートを建築する",
      "expectedOutcome": "success",
      "setup": [
        "/give @s obsidian 10",
        "/give @s flint_and_steel 1",
        "/give @s dirt 16"
      ],
      "assertions": [
        { "type": "block_at", "x": 5, "y": 100, "z": -2, "block": "obsidian" },
        { "type": "block_at", "x": 5, "y": 104, "z": -2, "block": "obsidian" }
      ]
    },
    {
      "skillName": "sleep-in-bed",
      "args": [false, false],
      "description": "夜になった遠征拠点でベッドへ入り朝まで休む",
      "expectedOutcome": "success",
      "setup": [
        "/time set midnight",
        "/setblock 3 100 0 red_bed[part=foot,facing=east]",
        "/setblock 4 100 0 red_bed[part=head,facing=east]"
      ],
      "assertions": [{ "type": "block_at", "x": 3, "y": 100, "z": 0, "block": "red_bed" }]
    },
    {
      "skillName": "enter-portal",
      "args": [4, 101, 0],
      "description": "完成済みネザーゲートへ入り次元を移動する",
      "expectedOutcome": "success",
      "setup": [
        "/fill 4 100 -1 4 104 2 obsidian",
        "/fill 4 101 0 4 103 1 nether_portal[axis=z]"
      ],
      "assertions": [{ "type": "dimension", "dimension": "the_nether" }]
    }
  ]
}
