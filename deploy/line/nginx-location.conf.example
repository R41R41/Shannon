# Include only in the verified existing sh4nnon.com TLS server block AFTER dev acceptance.
# Not a standalone server or an instruction to replace the existing nginx configuration.
location = /line/webhook {
    limit_except POST { deny all; }
    client_max_body_size 256k;
    proxy_pass http://127.0.0.1:15041/webhooks/line;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    proxy_send_timeout 10s;
    access_log off;
}
